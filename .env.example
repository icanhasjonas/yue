# Copy to .env (or .claude/.env, which wins). A real environment variable beats both.

# RunPod management key ("All" or Restricted with endpoint + template + volume write).
# Used ONLY by `yue runpod setup | status | teardown`.
RUNPOD_API_KEY=

# RunPod job key: a Restricted key whose only permission is Read/Write on the yue
# endpoint (console -> Settings -> API Keys -> Restricted). Used by every
# `--remote runpod` run; falls back to RUNPOD_API_KEY when unset.
YUE_RUNPOD_JOB_KEY=

# Optional: where `yue runpod setup` keeps endpoint/template/volume ids.
# YUE_RUNPOD_CONFIG=~/.config/yue/runpod.json

# Optional: Hugging Face token for faster/rate-limit-free weight downloads.
# HF_TOKEN=
